FROM cgr.dev/samcorp/python:3.13-dev@sha256:49f3083a2eaae9e86344276dc455bcd5e469d610ea25749fbe14ed00c1c65bb1

WORKDIR /app

USER root

COPY requirements.txt .

RUN --mount=type=secret,id=netrc,target=/root/.netrc \
    uv pip install --system --no-cache-dir \
      --index-strategy unsafe-best-match \
      --index-url "https://libraries.cgr.dev/python-remediated/simple" \
      --extra-index-url "https://libraries.cgr.dev/python/simple" \
      --extra-index-url "https://pypi.org/simple" \
      -r requirements.txt

COPY . .

EXPOSE 5000

USER nonroot

ENTRYPOINT ["python", "app.py"]
