FROM cgr.dev/samcorp/python:3.13-dev@sha256:ec0bcde48d788bfbe985f63423a1e006c073255b4701893f4330e5db0931e686

WORKDIR /app
USER root

COPY requirements.txt .
RUN --mount=type=secret,id=netrc,target=/root/.netrc \
    pip cache purge || true && \
    pip install --index-url https://libraries.cgr.dev/python-remediated/simple/ \
    --extra-index-url https://pypi.org/simple/ \
    -r requirements.txt && \
    pip freeze

COPY . .

EXPOSE 5000

ENTRYPOINT ["python", "app.py"]